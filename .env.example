# n8n
N8N_PORT=5678
N8N_HOST=0.0.0.0
# Set false only while serving the editor over plain HTTP. Set true again behind HTTPS.
N8N_SECURE_COOKIE=false
# Required for workflows that read $env in Code nodes (default in docker-compose.yml).
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Public URL Chatwoot uses to call webhooks (reverse proxy / tunnel in prod)
WEBHOOK_URL=https://n8n.example.com/

# Queue-mode deployment (docker-compose.queue.yml).
# Copy the existing value from /home/node/.n8n/config before migrating; changing it breaks stored credentials.
N8N_ENCRYPTION_KEY=
N8N_DB_NAME=n8n
REDIS_PASSWORD=
N8N_WORKER_REPLICAS=2
N8N_WORKER_CONCURRENCY=5
# Keep the default execution timeout below CONVERSATION_LEASE_SECONDS so recovery never overlaps a hung run.
N8N_EXECUTIONS_TIMEOUT=240
N8N_EXECUTIONS_TIMEOUT_MAX=300
N8N_AI_TIMEOUT_MAX_MS=180000
N8N_EXECUTIONS_DATA_MAX_AGE_HOURS=336
N8N_EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# Chatwoot (for HTTP Request nodes: $env.CHATWOOT_*)
CHATWOOT_BASE_URL=https://chat.example.com
CHATWOOT_ACCOUNT_ID=1
# User API token with account access. Used by n8n and default setup script mode.
CHATWOOT_API_ACCESS_TOKEN=
# Optional: platform token if CHATWOOT_AGENT_BOT_API=platform in setup script.
CHATWOOT_PLATFORM_ACCESS_TOKEN=
CHATWOOT_AGENT_BOT_API=account
# Agent Bot webhook secret used to verify X-Chatwoot-Signature against the raw request body.
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_WEBHOOK_AUTH_ENFORCED=false
CHATWOOT_INBOX_ID=

# Show Chatwoot typing indicator while the bot is processing (default: true)
CHATWOOT_TYPING_INDICATORS=true

# Handoff routing (optional)
CHATWOOT_ESCALATION_TEAM_ID=
CHATWOOT_ESCALATION_ASSIGNEE_ID=

# Guided flow state (legacy workflow) is stored in Chatwoot custom_attributes under n8n_guided_flow.
# Postgres-backed workflow stores durable state in local Postgres; Chatwoot gets lightweight metadata only.
# V3 Fetch Guided Flow can pull the published flow from the support frontend visual creator.
# Example: https://support.example.com or http://host.docker.internal:8787
GUIDED_FLOW_API_URL=

# Postgres (bot state for chatwoot-support-bot-postgres workflow)
# Host port mapped to the bot Postgres container (5432 is often taken by a local Postgres install)
POSTGRES_PORT=5433
POSTGRES_DB=chatwoot_bot
POSTGRES_USER=chatwoot_bot
POSTGRES_PASSWORD=chatwoot_bot
BOT_DB_HOST=postgres
BOT_DB_PORT=5432
BOT_DB_NAME=chatwoot_bot
BOT_DB_USER=chatwoot_bot
BOT_DB_PASSWORD=chatwoot_bot
BOT_DB_SSL=false
DEFAULT_GUIDED_FLOW_ID=support_main

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone (RAG guided bot workflow + MCP quickstart)
PINECONE_API_KEY=
# Default used by scripts/upsert-rag.mjs when unset: pro-golf-support
PINECONE_INDEX=pro-golf-support
# Optional Pinecone data-plane host. If empty, migration workflow resolves it from PINECONE_INDEX.
PINECONE_INDEX_HOST=
# Optional namespace; leave empty for default
PINECONE_NAMESPACE=
PINECONE_API_VERSION=2025-04
RAG_TOP_K=5
RAG_MIN_SCORE=0.72
CLASSIFIER_MIN_CONFIDENCE=0.65

# Chatwoot Postgres pgvector staging RAG.
# Use a dedicated Chatwoot DB role whose search_path is progolf_support, public.
CHATWOOT_PGVECTOR_DATABASE_URL=postgres://progolf_support_rag:password@chatwoot-postgres:5432/chatwoot_production
CHATWOOT_PGVECTOR_DB_SSL=false
# Set to false for self-signed DB certs when CHATWOOT_PGVECTOR_DB_SSL=true.
CHATWOOT_PGVECTOR_DB_SSL_REJECT_UNAUTHORIZED=true
PGVECTOR_SCHEMA=progolf_support
PGVECTOR_TABLE=progolf_faq_vectors
# Manual Pinecone -> PGVector migration workflow knobs.
PINECONE_MIGRATION_PREFIX=
PGVECTOR_MIGRATION_MAX_RECORDS=
PGVECTOR_MIGRATION_RECREATE=false
PGVECTOR_MIGRATION_PRUNE_STALE=false

# Idempotency: ignore duplicate message ids within this window (ms). Static store prunes older entries.
IDEMPOTENCY_WINDOW_MS=120000
# Skip processing if same conversation hit again within N ms (burst / multi-segment typing)
CONVERSATION_DEBOUNCE_MS=2000
# Durable per-conversation processing lease. Expired work is recovered by the minute schedule.
CONVERSATION_LEASE_SECONDS=300
# Processed inbound deliveries and outbound-effect records are cleaned up after this many days.
IDEMPOTENCY_RETENTION_DAYS=30
# Handoff after this many failed/low-confidence bot turns in same conversation
FAILED_TURN_THRESHOLD=2

GENERIC_TIMEZONE=UTC
TZ=UTC
